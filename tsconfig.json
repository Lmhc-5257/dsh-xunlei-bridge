{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["index.ts"],
  "exclude": ["node_modules", "dist"]
}
